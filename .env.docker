# Docker Environment Configuration
# Copy this to .env and update with your secure values

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017/file_integrity_db

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption Configuration
MASTER_KEY=change-this-to-a-32-byte-secure-key-for-production-use

# Application Configuration
MAX_FILE_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=100

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
